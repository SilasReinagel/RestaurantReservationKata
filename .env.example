OPENAI_API_KEY=sk-...
# Any tool-calling chat model you have access to.
OPENAI_MODEL=gpt-5-mini
# Optional, only for reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=

BV_TIMEZONE=America/New_York
BV_RESTAURANT_PHONE=(555) 010-0100
BV_DB_PATH=data/bella_vista.db
# Seed two extra bookings so BRD example 10.2 ("6 at 8pm tomorrow is full") is reproducible.
BV_SEED_DEMO_SCENARIOS=true
